<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="28dp"
    android:gravity="center_horizontal"
    tools:context=".ejercicios.ejercicio8.Ejercicio8Activity">

    <TextView
        android:id="@+id/lblTituloCoordenadas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ejercicio 8 - Tracker de Coordenadas X e Y"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textColor="@color/primary_color"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/lblPosicionPointer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Posición: X: -- px | Y: -- px"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/custom_blue"
        android:textAlignment="center"
        android:layout_marginBottom="24dp" />

    <FrameLayout
        android:id="@+id/panelSuperficieTouch"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F0F4C3"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Presiona o arrastra el dedo en este cuadro"
            android:textSize="17sp"
            android:textColor="#558B2F" />

    </FrameLayout>

</LinearLayout>