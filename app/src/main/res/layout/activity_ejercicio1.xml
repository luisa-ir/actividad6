<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="28dp"
    android:gravity="center_horizontal"
    tools:context=".ejercicios.ejercicio1.Ejercicio1Activity">

    <TextView
        android:id="@+id/lblTituloModulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ejercicio 1 - Contador Secuencial en Hilo"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textColor="@color/primary_color"
        android:layout_marginBottom="36dp" />

    <TextView
        android:id="@+id/lblContadorOutput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Presiona comenzar para iniciar..."
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/custom_blue"
        android:textAlignment="center"
        android:layout_marginBottom="44dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnComenzarSecuencia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comenzar Hilo"
        android:textSize="16sp"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp" />

</LinearLayout>