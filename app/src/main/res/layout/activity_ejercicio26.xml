<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    tools:context=".ejercicios.ejercicio26.Ejercicio26Activity">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ejercicio 26 - Detector de Sacudidas"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/tvEstadoShake"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sacude el dispositivo..."
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:textAlignment="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvMagnitudAceleracion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aceleración actual: -- m/s²"
        android:textSize="16sp"
        android:textColor="?android:attr/textColorSecondary"
        android:textAlignment="center" />

</LinearLayout>