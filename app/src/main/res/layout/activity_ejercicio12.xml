<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="28dp"
    android:gravity="center_horizontal"
    tools:context=".ejercicios.ejercicio12.Ejercicio12Activity">

    <TextView
        android:id="@+id/lblTituloGestos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ejercicio 12 - Reconocimiento de Gestos"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textColor="@color/primary_color"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtGestoProcesado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gesto reconocido: En espera"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/custom_purple"
        android:textAlignment="center"
        android:layout_marginBottom="24dp" />

    <FrameLayout
        android:id="@+id/superficieGesto"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#E1F5FE"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Realiza Tap, Long Press o Fling sobre esta área"
            android:textSize="17sp"
            android:textColor="#0288D1"
            android:textAlignment="center" />

    </FrameLayout>

</LinearLayout>