<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".ejercicios.ejercicio10.Ejercicio10Activity">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio 10 - Objeto Arrastrable"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Arrastra la pelota con el dedo por cualquier parte de la pantalla"
        android:textSize="14sp"
        android:textAlignment="center"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="16dp" />

    <FrameLayout
        android:id="@+id/containerPelota"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FAFAFA">

        <ImageView
            android:id="@+id/ivPelota"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:src="@drawable/shape_pelota"
            android:contentDescription="Pelota arrastrable" />

    </FrameLayout>

</LinearLayout>