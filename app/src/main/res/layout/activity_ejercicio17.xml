<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".ejercicios.ejercicio17.Ejercicio17Activity">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio 17 - Puntos Multitáctiles Temporales"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Toca con varios dedos. Cada dedo muestra un punto que sigue el movimiento y desaparece al soltarlo."
        android:textSize="14sp"
        android:textAlignment="center"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="16dp" />

    <com.example.actividad6.ejercicios.ejercicio17.VistaPuntosMultitactil
        android:id="@+id/vistaPuntos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FAFAFA"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>