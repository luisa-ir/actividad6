<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    tools:context=".ejercicios.ejercicio21.Ejercicio21Activity">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ejercicio 21 - Orientación del Dispositivo"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/tvAzimut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Azimut (Brújula): --°"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:textAlignment="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvPitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pitch (Inclinación frontal): --°"
        android:textSize="20sp"
        android:textAlignment="center"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvRoll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Roll (Inclinación lateral): --°"
        android:textSize="20sp"
        android:textAlignment="center"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginBottom="24dp" />

</LinearLayout>