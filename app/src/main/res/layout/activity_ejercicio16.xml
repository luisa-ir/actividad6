<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    tools:context=".ejercicios.ejercicio16.Ejercicio16Activity">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ejercicio 16 - Rotación con 2 Dedos"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvAngulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ángulo de rotación: 0.0°"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:textAlignment="center"
        android:layout_marginBottom="24dp" />

    <FrameLayout
        android:id="@+id/rotationArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#EFEBE9"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivRotateTarget"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_launcher_foreground"
            android:background="@drawable/shape_pelota"
            android:contentDescription="Objeto giratorio" />

    </FrameLayout>

</LinearLayout>