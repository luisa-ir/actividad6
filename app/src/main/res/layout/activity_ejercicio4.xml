<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="28dp"
    android:gravity="center_horizontal"
    tools:context=".ejercicios.ejercicio4.Ejercicio4Activity">

    <TextView
        android:id="@+id/lblTituloCalculo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ejercicio 4 - Suma de N Números (MiTarea)"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textColor="@color/primary_color"
        android:layout_marginBottom="32dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingrese la cantidad N"
        android:layout_marginBottom="24dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputLimiteN"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="100" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCalcularSuma"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calcular Suma en Hilo"
        android:textSize="16sp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/lblResultadoSuma"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resultado: -"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/custom_blue"
        android:textAlignment="center" />

</LinearLayout>