<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    tools:context=".ejercicios.ejercicio24.Ejercicio24Activity">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ejercicio 24 - Detector de Pasos"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/tvContadorPasos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="64sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvEtiquetaPasos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pasos detectados"
        android:textSize="18sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="48dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReiniciarPasos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reiniciar Contador"
        android:textSize="16sp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

</LinearLayout>