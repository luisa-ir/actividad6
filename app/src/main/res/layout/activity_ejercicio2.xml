<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="28dp"
    android:gravity="center_horizontal"
    tools:context=".ejercicios.ejercicio2.Ejercicio2Activity">

    <TextView
        android:id="@+id/lblTituloProgreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ejercicio 2 - Simulación de Carga Progresiva"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textColor="@color/primary_color"
        android:layout_marginBottom="32dp" />

    <ProgressBar
        android:id="@+id/barProgresoCarga"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/custom_blue"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/txtPorcentajeStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 %"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="@color/accent_color"
        android:layout_marginBottom="44dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIniciarProcesoCarga"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Iniciar Carga Progresiva"
        android:textSize="16sp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

</LinearLayout>