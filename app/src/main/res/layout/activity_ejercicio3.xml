<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".ejercicios.ejercicio3.Ejercicio3Activity">

    <TextView
        android:id="@+id/lblTituloHilos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio 3 - Hilos Simultáneos Intercalados"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textColor="@color/primary_color"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnComenzarEjecucionHilos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejecutar 3 Hilos Simultáneos"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/custom_card_bg"
        android:padding="14dp">

        <TextView
            android:id="@+id/txtHistorialHilos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Presiona el botón para comenzar la ejecución de hilos..."
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:textColor="@color/secondary_color" />

    </ScrollView>

</LinearLayout>