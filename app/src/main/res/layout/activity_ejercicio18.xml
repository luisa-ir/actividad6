<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    tools:context=".ejercicios.ejercicio18.Ejercicio18Activity">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ejercicio 18 - Arrastrar, Escalar y Girar"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Utiliza 1 dedo para mover, 2 dedos para escalar (Pinch) y girar la imagen"
        android:textSize="14sp"
        android:textAlignment="center"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="16dp" />

    <FrameLayout
        android:id="@+id/transformContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#ECEFF1"
        android:clipChildren="false"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivControlTarget"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_launcher_foreground"
            android:background="@drawable/shape_pelota"
            android:contentDescription="Imagen transformable" />

    </FrameLayout>

</LinearLayout>